# Railway variables: use a Postgres service and reference its DATABASE_URL in this service.
DATABASE_URL=${{Postgres.DATABASE_URL}}
PUBLIC_ORIGIN=https://YOUR-APP.up.railway.app
OWNER_PASSWORD=CHANGE_TO_LONG_UNIQUE_SECRET
COMPANION_PASSWORD=CHANGE_TO_OTHER_LONG_UNIQUE_SECRET
DEVICE_TOKEN=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
SESSION_SECRET=REPLACE_WITH_ANOTHER_RANDOM_64_HEX_CHARACTERS
SECURE_COOKIES=1
